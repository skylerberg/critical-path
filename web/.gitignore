node_modules
dist
dev-dist
coverage
# Throwaway browser probes. CLAUDE.md asks for them inside the repo, because one
# written to /tmp cannot resolve vite or playwright — so they need a name that is
# ignored here and by eslint, or every scratch file is a commit risk and a red
# lint gate.
scripts/tmp-*
# The same escape hatch for a throwaway *config*, which cannot use the prefix
# above: a flat eslint config resolves its `files:` patterns relative to its own
# directory, so one under scripts/ matches nothing in src/, and it needs a
# node_modules beside it to resolve plugins. Both pin it to this package's own
# root — web/, which is what "the root" meant while web/ was its own repository
# and no longer means the top of the checkout, where there is no node_modules to
# resolve against and where this file's patterns do not reach.
*.tmp.config.js
# Vite loads .env, .env.local and .env.<mode> from here, and scripts/new-worktree.sh
# copies every untracked .env* into each package of a new worktree.
.env
.env.*
!.env.example
