{
  "name": "critical-path-preview-edge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --outfile=dist/index.mjs --packages=external",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --log-level warn \"*.ts\" \"*.js\"",
    "format:check": "prettier --check \"*.ts\" \"*.js\"",
    "test": "node --test auth.test.ts",
    "check:all": "pnpm run type-check && pnpm run lint && pnpm run format:check && pnpm test",
    "prepare": "if [ -f ../scripts/setup-hooks.mjs ]; then node ../scripts/setup-hooks.mjs; fi"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "esbuild": "^0.28.1",
    "eslint": "10.8.1",
    "prettier": "3.8.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
