{
  "name": "critical-path-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "bin": {
    "cpath": "bin/cpath.mjs"
  },
  "scripts": {
    "generate-api": "node scripts/generate-api-types.mjs && prettier --write src/api/api.generated.ts",
    "generate-realtime": "node scripts/generate-realtime-types.mjs && prettier --write src/api/realtime.generated.ts",
    "type-check": "tsc -p tsconfig.json",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write --log-level warn \"src/**/*.ts\" \"tests/**/*.ts\" \"bin/*.mjs\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"bin/*.mjs\" \"scripts/*.mjs\"",
    "check": "pnpm run type-check && pnpm run lint && pnpm run format:check"
  },
  "dependencies": {
    "commander": "15.0.0",
    "fractional-indexing": "^4.0.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm-strikethrough": "2.0.0",
    "mdast-util-to-markdown": "2.1.2",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "openapi-fetch": "0.17.0",
    "tsx": "4.23.1"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "eslint": "^10.6.0",
    "openapi-typescript": "7.13.0",
    "prettier": "~3.8.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
