{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.{ts,mjs}",
        "eslint-rules/no-unqualified-kysely-columns.js",
        "src/db/migrations/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.{ts,mjs}",
        "eslint-rules/**/*.js",
        "tests/**/*.ts",
        "bench/**/*.ts"
      ]
    },
    "cli": {
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts",
        "bin/*.mjs",
        "scripts/*.mjs"
      ]
    }
  },
  "ignore": [
    "src/db/types.generated.ts",
    "cli/src/api/*.generated.ts"
  ],
  "ignoreDependencies": [
    "kysely-codegen",
    "swagger-ui-dist"
  ]
}
