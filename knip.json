{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/{dump-openapi,prune-test-databases,setup-hooks,with-test-db}.{ts,mjs}",
        "eslint-rules/no-unqualified-kysely-columns.js",
        "src/db/migrations/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.{ts,mjs}",
        "eslint-rules/**/*.js",
        "tests/**/*.ts"
      ]
    },
    "cli": {
      "project": ["src/**/*.ts", "tests/**/*.ts", "bin/*.mjs", "scripts/*.mjs"]
    }
  },
  "ignore": ["src/db/types.ts", "cli/src/api/api.generated.ts"]
}
