# Server
PORT=3001
ENVIRONMENT=development
# Set TRUST_PROXY=true only when running behind a reverse proxy that appends
# the client IP to X-Forwarded-For; the rate limiter then uses the entry
# TRUST_PROXY_HOPS from the right (default 1) instead of the socket address.
# GCP external HTTPS load balancers append "<client-ip>, <lb-ip>", so use 2.
# TRUST_PROXY=true
# TRUST_PROXY_HOPS=1

# Database (local Postgres, no password)
DB_HOSTNAME=127.0.0.1
DB_PORT=5432
DB_USER=skylerberg
DB_DATABASE=game_dev
# DB_PASSWORD=
# DB_CA_CERT_PATH=
# Connections per process (vitest lowers this to 5 so parallel suites fit
# inside max_connections)
# DB_POOL_MAX=10

# Storage (disk locally; gcs in production uses Application Default Credentials)
STORAGE_DRIVER=disk
STORAGE_DISK_ROOT=./data/uploads
# STORAGE_GCS_BUCKET=
# Caps one file attachment, and the images plus attachments of one project
# ATTACHMENT_MAX_BYTES=52428800
# PROJECT_STORAGE_QUOTA_BYTES=1073741824

# Redis (unset = in-process realtime bus and per-process rate limits;
# required for multi-replica so events and limits are shared)
# REDIS_URL=redis://:password@host:6379

# Auth
SESSION_TTL_DAYS=30

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# LOG_FORMAT=pretty

# Password reset (required in production; development uses a fixed dev-only secret)
# PASSWORD_RESET_SECRET=

# Web app origin, used to build verification links
APP_URL_BASE=http://localhost:5173
# Signs verification links; falls back to PASSWORD_RESET_SECRET when unset
# EMAIL_TOKEN_SECRET=

# Email (console logs the full email; ses sends via AWS SES v2)
EMAIL_DRIVER=console
# SES_REGION=us-west-2
# SES_FROM_ADDRESS=no-reply@example.com
