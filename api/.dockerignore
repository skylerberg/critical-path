# Resolved against the build context, which is api/ — cli/, preview-edge/,
# .github/ and .githooks/ are siblings of it and cannot be reached from here.
.git
.claude
# Globbed: the bare name matches only the top level, and pnpm gives every nested
# package a node_modules of its own.
**/node_modules
dist
data
coverage
tests
k8s
eslint-rules
# Developer tooling only — codegen, the test-database helpers, the changed-file
# runner. Nothing in the image reads any of it, and keeping it out of the context
# is what lets api-deploy.yaml's paths filter leave api/scripts/** off the list.
scripts
.env
.env.*
*.md
openapi.json
