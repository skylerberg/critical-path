{
  "name": "critical-path-api",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scarfSettings": {
    "enabled": false
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "start": "node --env-file=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:prod": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.mjs --packages=external",
    "type-check": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --log-level warn \"src/**/*.ts\" \"tests/**/*.ts\" \"bench/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"eslint-rules/**/*.js\" \"*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"bench/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"eslint-rules/**/*.js\" \"*.{ts,js}\"",
    "knip": "knip",
    "check:all": "pnpm run type-check && pnpm run lint && pnpm run format:check && pnpm run knip && pnpm test",
    "migrate": "node --env-file=.env --import tsx src/db/migrate.ts",
    "migrate:down": "node --env-file=.env --import tsx src/db/migrate.ts down",
    "migrate:test": "node --env-file=.env.test --import tsx scripts/with-test-db.ts node --import tsx src/db/migrate.ts",
    "test:db:prune": "node --env-file=.env.test --import tsx scripts/prune-test-databases.ts",
    "kysely-codegen": "node --env-file=.env.test --import tsx scripts/codegen-types.ts",
    "openapi:dump": "node --import tsx scripts/dump-openapi.ts",
    "realtime:dump": "node --import tsx scripts/dump-realtime-events.ts",
    "test": "node --env-file=.env.test node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file=.env.test node_modules/vitest/vitest.mjs",
    "test:coverage": "node --env-file=.env.test node_modules/vitest/vitest.mjs run --coverage",
    "test:related": "node --env-file=.env.test node_modules/vitest/vitest.mjs related --run",
    "test:changed": "node --env-file=.env.test scripts/test-changed.mjs",
    "prepare": "if [ -f ../scripts/setup-hooks.mjs ]; then node ../scripts/setup-hooks.mjs; fi",
    "bench": "node --env-file=.env.test --import tsx bench/run.ts",
    "bench:heavy": "node --env-file=.env.test --import tsx bench/run.ts --scale=heavy"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1082.0",
    "@google-cloud/storage": "^7.21.0",
    "@hono/node-server": "^2.0.8",
    "@hono/standard-validator": "0.2.3",
    "@hono/swagger-ui": "~0.6.1",
    "@standard-community/standard-json": "^0.3.5",
    "@standard-community/standard-openapi": "~0.2.9",
    "argon2": "~0.44.0",
    "arktype": "2.2.3",
    "fractional-indexing": "^4.0.0",
    "hono": "~4.12.28",
    "hono-openapi": "1.3.1",
    "kysely": "~0.29.3",
    "openapi-types": "^12.1.3",
    "pg": "~8.22.0",
    "redis": "^6.1.0",
    "rrule": "^2.8.1",
    "sharp": "^0.35.3",
    "swagger-ui-dist": "5.32.12",
    "tsx": "^4.23.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@standard-schema/spec": "^1.1.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "26.2.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "~4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "10.8.1",
    "fflate": "^0.8.3",
    "knip": "^6.31.0",
    "kysely-codegen": "~0.20.0",
    "prettier": "3.8.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "~4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
