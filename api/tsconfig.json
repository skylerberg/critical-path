{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "lib": ["ESNext"]
  },
  // cli/ is a separate npm package with its own lock and node_modules, but it
  // belongs to this TypeScript project so that an editor resolves its files
  // against these options. Left out, every cli file falls back to an inferred
  // project with no module resolution, and reads as a wall of "cannot find
  // module" that has nothing to do with the code.
  "include": ["src/**/*", "tests/**/*", "scripts/**/*", "vitest.config.ts", "cli/**/*", "bench/**/*"],
  "exclude": ["**/node_modules", "**/dist"]
}
