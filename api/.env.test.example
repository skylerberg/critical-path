# The test suite reads this file, not .env: every `test` script passes
# `--env-file=.env.test`, and node hard-errors when it is missing. Copy it to
# .env.test (scripts/bootstrap.sh does).

# Database. This is the *base* name and must end in _test — vitest appends this
# package's directory and a hash of its absolute path, creates that database on
# first use and migrates it, so the role needs CREATEDB. Two checkouts therefore
# never share one, which the opening TRUNCATE makes essential.
DB_USER=skylerberg
DB_DATABASE=critical_path_test

# Attachments land here rather than under the dev server's upload root.
STORAGE_DISK_ROOT=./data/test-uploads

ENVIRONMENT=test

# Two files drive the shared rate limiter against a real server, which is the
# only thing anywhere that runs the shipped Lua and the pub/sub. Delete this
# line and they skip with a notice, leaving that path unexercised; leave it
# pointing at a server that is not listening and they fail rather than skip.
# `brew services start redis` is the fix for the second. Never name REDIS_URL
# here instead: that one puts every test file on one signup budget and the run
# collapses into 429s.
REDIS_TEST_URL=redis://127.0.0.1:6379/15
